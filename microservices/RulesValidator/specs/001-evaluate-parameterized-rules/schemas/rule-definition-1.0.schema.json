{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-vinculaciones/schemas/rule-definition-1.0.schema.json",
  "title": "Definición neutral de regla 1.0",
  "$ref": "#/$defs/nodoRaiz",
  "$defs": {
    "valor": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/referenciaParametro"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "referenciaParametro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "parametro",
        "factor"
      ],
      "properties": {
        "tipo": {
          "const": "PARAMETRO_MULTIPLICADO"
        },
        "parametro": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
        },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "condicion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "campo",
        "operador",
        "valor"
      ],
      "properties": {
        "tipo": {
          "const": "CONDICION"
        },
        "campo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "operador": {
          "enum": [
            "IGUAL",
            "DIFERENTE",
            "MAYOR",
            "MAYOR_IGUAL",
            "MENOR",
            "MENOR_IGUAL",
            "EN",
            "NO_EN"
          ]
        },
        "valor": {
          "$ref": "#/$defs/valor"
        }
      }
    },
    "grupo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "operadorLogico",
        "condiciones"
      ],
      "properties": {
        "tipo": {
          "const": "GRUPO"
        },
        "operadorLogico": {
          "enum": [
            "Y",
            "O"
          ]
        },
        "condiciones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/condicion"
              },
              {
                "$ref": "#/$defs/grupo"
              }
            ]
          }
        }
      }
    },
    "nodo": {
      "oneOf": [
        {
          "$ref": "#/$defs/condicion"
        },
        {
          "$ref": "#/$defs/grupo"
        }
      ]
    },
    "nodoRaiz": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "versionEsquema",
            "tipo",
            "campo",
            "operador",
            "valor"
          ],
          "properties": {
            "versionEsquema": {
              "const": "1.0"
            },
            "tipo": {
              "const": "CONDICION"
            },
            "campo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "operador": {
              "enum": [
                "IGUAL",
                "DIFERENTE",
                "MAYOR",
                "MAYOR_IGUAL",
                "MENOR",
                "MENOR_IGUAL",
                "EN",
                "NO_EN"
              ]
            },
            "aplicabilidad": {
              "$ref": "#/$defs/nodo"
            },
            "valor": {
              "$ref": "#/$defs/valor"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "versionEsquema",
            "tipo",
            "operadorLogico",
            "condiciones"
          ],
          "properties": {
            "versionEsquema": {
              "const": "1.0"
            },
            "tipo": {
              "const": "GRUPO"
            },
            "operadorLogico": {
              "enum": [
                "Y",
                "O"
              ]
            },
            "aplicabilidad": {
              "$ref": "#/$defs/nodo"
            },
            "condiciones": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/condicion"
                  },
                  {
                    "$ref": "#/$defs/grupo"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
